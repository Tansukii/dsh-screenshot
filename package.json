{
  "name": "dsh-screenshot",
  "version": "1.0.1",
  "description": "Built-in screenshot tool for DeepSeek Harness on Windows: instant region capture, annotations, colour picker, all local.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "screenshot",
    "snipping-tool",
    "windows",
    "annotation"
  ],
  "files": [
    "bin/",
    "lib/",
    "src/",
    "cordis.patch.yml",
    "docs/"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
